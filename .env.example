# Copy this file to .env and fill in real values.
# .env is git-ignored — never commit real secrets.

# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-to-a-long-random-value

# "1"/"true" for local development only. Leave unset (or "0") in production.
FLASK_DEBUG=0

# Where the app should listen when run directly (python app.py).
HOST=0.0.0.0
PORT=8000

# Local, self-hosted database — just a file on disk, no separate DB server.
DATABASE_PATH=./data/rpg_sys.db

# Comma-separated list of origins allowed to open a Socket.IO connection —
# set this to your real domain(s) in production, e.g.:
#   CORS_ORIGINS=https://rpg.example.com
# Leave unset to allow any origin (fine for a first test run, not for prod).
CORS_ORIGINS=

# Only needed if you run more than one worker process, or want login
# sessions to survive a restart across a reboot. Point at a local Redis
# (e.g. `redis-server` running on the same Debian box) — this is optional,
# the app works fine without it for a single-process deployment.
REDIS_URL=

# Require HTTPS-only cookies. Turn this on once you have TLS via nginx/certbot.
SESSION_COOKIE_SECURE=1

# How long a login session stays valid without activity.
SESSION_LIFETIME_MINUTES=120

MAX_CONTENT_LENGTH_MB=50
